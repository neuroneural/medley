# Copy this file to config/site.env and edit it for your cluster.
# config/site.env is ignored by Git.

RAW_ROOT=/path/to/raw/BabyOpen
WORK_ROOT=/path/to/medley_work
IBEAT_BIND_ROOT=/path/to/ibeat_bind_root
IBEAT_OUTPUT_ROOT=/path/to/ibeat_outputs
IBEAT_SIF=/path/to/ibeat_v2.sif

FS_SUBJECTS_DIR=/path/to/freesurfer_subjects
SYNTHSEG_ROOT=/path/to/medley_work/_tool_outputs/synthseg
CHARM_ROOT=/path/to/medley_work/_tool_outputs/charm

CONDA_BASE=/path/to/miniconda3
CONDA_ENV=/path/to/conda/environment

ACCOUNT=your_slurm_account
GPU_PARTITION=your_gpu_partition
CPU_PARTITION=your_cpu_partition
LONG_PARTITION=your_long_partition
FREESURFER_HOME=/path/to/freesurfer/7.4.1
# Load FreeSurfer through the cluster module system (preferred over a raw
# FREESURFER_HOME). Confirm the exact name with:  module avail freesurfer
FREESURFER_MODULE=freesurfer/7.4.1
# Setup aborts if the loaded build does not contain this string (guards
# against a personal dev build being picked up). Set empty to disable.
FREESURFER_EXPECT_VERSION=7.4.1
EMAIL=

# Use an absolute path. Do not leave blank when CHARM is enabled.
SIMNIBS_ENV_SCRIPT=/absolute/path/to/SimNIBS-4.1/simnibs_env/bin/activate

AGES=1-8
CHARM_INPUT=oT1e-18-big3.nii.gz
CHARM_FORCE_QFORM=1
CHARM_FORCE_RUN=1
FREESURFER_FINAL=enhanced_enlarged
SYNTHSEG_FINAL=raw_robust

IBEAT_PARALLEL=5
GATHER_PARALLEL=12
PREPROCESS_PARALLEL=8
SYNTHSEG_PARALLEL=8
FREESURFER_PARALLEL=4
CHARM_PARALLEL=4
POSTPROCESS_PARALLEL=8
CONSOLIDATE_PARALLEL=4
